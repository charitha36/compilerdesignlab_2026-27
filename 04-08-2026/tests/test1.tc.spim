.text
.globl main
main:
    subu $sp, $sp, 4
    sw   $ra, 0($sp)
    subu $sp, $sp, 4
    sw   $fp, 0($sp)
    addiu $fp, $sp, -4
    move $sp, $fp
    li $t0, 5
    sw $t0,None
    addiu $sp, $fp, 4
    lw    $fp, 0($sp)
    addiu $sp, $sp, 4
    lw    $ra, 0($sp)
    addiu $sp, $sp, 4
    jr    $ra
